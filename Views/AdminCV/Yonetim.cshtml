@model List<CvDownloadLog>
@{
    ViewData["Title"] = "CV Yönetimi";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
    bool cvVarMi = ViewBag.CvVar ?? false;
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
    .pdf-preview-container {
        position: relative;
        overflow: hidden;
        border-radius: 6px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

        .pdf-preview-container:hover {
            transform: scale(1.02);
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
        }

    label {
        font-weight: bold;
    }
    .pdf-preview-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        opacity: 0;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.3s ease;
        font-weight: bold;
    }

    .pdf-preview-container:hover .pdf-preview-overlay {
        opacity: 1;
    }

    .modal-dialog.modal-xl {
        max-width: 90%;
    }

    .modal-body embed {
        width: 100%;
        height: 85vh;
        border: none;
    }
</style>

<br />
<h4 class="card-title mb-4">📄 CV Yönetimi</h4>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">CV Güncelle</div>
            <div class="card-body">

                @if (cvVarMi)
                {
                    <div class="mb-3 text-center">
                        <h6 class="text-secondary mb-2">📄 Mevcut CV Önizleme</h6>

                        <div class="pdf-preview-container" id="cvPreviewBox">
                            <embed src="/cv/cv.pdf#toolbar=0" type="application/pdf"
                                   width="100%" height="300px"
                                   class="border rounded shadow-sm mb-2" />
                            <div class="pdf-preview-overlay">
                                🔍 Tam Ekranda Görüntüle
                            </div>
                        </div>

                        <a href="/AdminCv/MevcutCv" target="_blank" class="btn btn-outline-success w-100">
                            <i class="fa fa-file-pdf-o"></i> Mevcut CV’yi Gör / İndir
                        </a>
                    </div>
                }
                else
                {
                    <div class="alert alert-secondary text-center py-3 mb-3">
                        📂 Henüz CV yüklenmemiş.
                    </div>
                }

                <form id="cvForm" enctype="multipart/form-data">
                    <div class="form-group mb-3">
                        <label for="pdfFile">Yeni CV (PDF):</label>
                        <input type="file" class="form-control" id="pdfFile" name="pdfFile" accept="application/pdf" required />
                        <small class="text-muted">Sadece PDF formatında, max 5 MB.</small>
                    </div>

                    <div class="text-center mb-3">
                        <embed id="pdfPreview" type="application/pdf"
                               width="100%" height="300px"
                               class="d-none border rounded shadow-sm" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100" id="btnUpload">
                        <i class="bi bi-cloud-upload"></i> Yükle
                    </button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span>CV İndirme Logları</span>
            </div>
            <div class="card-body table-responsive">
                <table id="yourTableId" class="table table-striped table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>IP</th>
                            <th>Konum</th>
                            <th>Kullanıcı Bilgisi</th>
                            <th>Tarih</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CvDownloadLog log in Model)
                        {
                            <tr>
                                <td>@log.ID</td>
                                <td>@log.IPAdress</td>
                                <td>@log.UserGeo</td>
                                <td>@log.UserInfo</td>
                                <td>@log.DownloadDate.ToString("dd MMMM dddd HH:mm:ss", new System.Globalization.CultureInfo("tr-TR"))</td>
                                <td>
                                    <form asp-action="LogSil" asp-route-id="@log.ID" method="post" class="deleteForm" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fa fa-trash"></i> Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cvModal" tabindex="-1" aria-labelledby="cvModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="cvModalLabel">CV Önizleme - Tam Ekran</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <embed id="cvModalEmbed" type="application/pdf" />
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const pdfInput = document.getElementById('pdfFile');
        const preview = document.getElementById('pdfPreview');
        const btnUpload = document.getElementById('btnUpload');
        const form = document.getElementById('cvForm');

        pdfInput?.addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;

            if (file.size > 5 * 1024 * 1024) {
                Swal.fire('Uyarı', 'PDF en fazla 5 MB olabilir.', 'warning');
                this.value = '';
                preview.classList.add('d-none');
                return;
            }

            if (file.type !== 'application/pdf') {
                Swal.fire('Hata', 'Sadece PDF dosyaları yüklenebilir.', 'error');
                this.value = '';
                preview.classList.add('d-none');
                return;
            }

            const reader = new FileReader();
            reader.onload = e => {
                preview.src = e.target.result;
                preview.classList.remove('d-none');
                preview.scrollIntoView({ behavior: 'smooth', block: 'center' });
            };
            reader.readAsDataURL(file);
        });

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            const file = pdfInput.files[0];
            if (!file) {
                Swal.fire('Uyarı', 'Lütfen PDF seçiniz.', 'warning');
                return;
            }

            const fd = new FormData();
            fd.append('pdfFile', file);
            btnUpload.disabled = true;
            btnUpload.innerHTML = '<i class="bi bi-arrow-repeat spin me-1"></i> Yükleniyor...';

            fetch('/AdminCv/Guncelle', { method: 'POST', body: fd })
                .then(async r => {
                    btnUpload.disabled = false;
                    btnUpload.innerHTML = '<i class="bi bi-cloud-upload"></i> Yükle';
                    const res = await r.json();

                    Swal.fire({
                        icon: res.success ? 'success' : 'error',
                        title: res.success ? 'Başarılı!' : 'Hata!',
                        text: res.message,
                        timer: 1800,
                        showConfirmButton: false
                    }).then(() => {
                        if (res.success) location.reload();
                    });
                })
                .catch(() => {
                    btnUpload.disabled = false;
                    btnUpload.innerHTML = '<i class="bi bi-cloud-upload"></i> Yükle';
                    Swal.fire('Hata', 'Sunucuya ulaşılamadı.', 'error');
                });
        });

        document.querySelectorAll(".deleteForm").forEach(form => {
            form.addEventListener("submit", function (e) {
                e.preventDefault();
                Swal.fire({
                    title: "Emin misiniz?",
                    text: "Bu log kalıcı olarak silinecek!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#3085d6",
                    confirmButtonText: "Evet, sil!",
                    cancelButtonText: "Vazgeç"
                }).then(result => {
                    if (result.isConfirmed) {

                        sessionStorage.setItem("swalType", "success");
                        sessionStorage.setItem("swalMessage", "Kayıt başarıyla silindi.");
                        form.submit();
                    }
                });
            });
        });

        const type = sessionStorage.getItem("swalType");
        const message = sessionStorage.getItem("swalMessage");
        if (type && message) {
            Swal.fire({
                icon: type,
                title: type === "success" ? "Başarılı!" : "Hata!",
                text: message,
                timer: 2200,
                showConfirmButton: false
            });
            sessionStorage.removeItem("swalType");
            sessionStorage.removeItem("swalMessage");
        }
        const previewBox = document.getElementById('cvPreviewBox');
        const modalEl = document.getElementById('cvModal');

        if (previewBox && modalEl) {
            const modal = new bootstrap.Modal(modalEl);

            previewBox.addEventListener('click', () => {
                const modalBody = modalEl.querySelector('.modal-body');
                modalBody.innerHTML = '';
                const embed = document.createElement('embed');
                embed.type = 'application/pdf';
                embed.width = '100%';
                embed.height = '85vh';
                embed.src = `/cv/cv.pdf#toolbar=1&v=${Date.now()}`;
                modalBody.appendChild(embed);
                modal.show();
            });

            modalEl.addEventListener('hidden.bs.modal', () => {
                const modalBody = modalEl.querySelector('.modal-body');
                modalBody.innerHTML = '';
            });

            modalEl.addEventListener('keydown', e => {
                if (e.key === 'Escape') {
                    const modalBody = modalEl.querySelector('.modal-body');
                    modalBody.innerHTML = '';
                }
            });
        }
    });
</script>