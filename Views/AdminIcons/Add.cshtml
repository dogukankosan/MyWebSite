@model Icons

@{
    ViewData["Title"] = "İkon Ekle";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>

    #iconPreviewHost i,
    #iconPreviewHost svg {
        font-size: 14px !important; 
        width: 1em !important;
        height: 1em !important;
        line-height: 1 !important;
        color: #555;
        vertical-align: middle;
    }

    label {
        font-weight: bold;
    }
    #iconPreviewHost {
        display: inline-flex;
        align-items: center;
    }

        #iconPreviewHost i::before {
            font-size: inherit !important;
        }

    .status-toggle {
        cursor: pointer;
        user-select: none;
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
        margin-top: 8px;
    }

    .toggle-wrapper {
        width: 46px;
        height: 24px;
        border-radius: 12px;
        background: #ccc;
        position: relative;
        transition: background-color .3s ease;
    }

        .toggle-wrapper.active {
            background: #198754;
        }

    .toggle-switch {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #fff;
        position: absolute;
        top: 2px;
        left: 2px;
        transition: left .3s ease;
        box-shadow: 0 1px 3px rgba(0,0,0,.2);
    }

    .toggle-wrapper.active .toggle-switch {
        left: 24px;
    }

    .status-label {
        margin-top: 5px;
        font-size: .9rem;
        font-weight: 600;
        transition: color .3s ease;
    }

    .btn {
        transition: all .2s ease-in-out;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0,0,0,.15);
        }
</style>

<form id="iconAddForm" method="post" autocomplete="off">
    <input type="hidden" id="Status" name="Icon.Status" value="true" />
    <br />
    <h4>İkon Ekleme Sayfası</h4>
    <hr />

    <div class="form-group">
        <label for="Icon">İkon Sınıfı: </label> <span style="color:red;">*</span>
        <input type="text" class="form-control" name="Icon.Icon" id="Icon"
               placeholder="fa-solid fa-bug, fa-regular fa-user, vb."
               required minlength="4" maxlength="200" />
        <span id="IconError" class="text-danger mt-1 d-block"></span>
    </div>

    <div class="form-group">
        <label>Önizleme:</label><br />

        <span id="iconPreviewHost" style="display:none;"></span>
    </div>

    <div class="form-group mt-2">
        <label>Durum:</label><br />
        <div class="status-toggle" id="statusToggle">
            <div class="toggle-wrapper active"><div class="toggle-switch"></div></div>
            <div class="status-label text-success">
                <i class="bi bi-check-circle-fill text-success"></i> <span>Aktif</span>
            </div>
        </div>
        <span id="StatusError" class="text-danger mt-1 d-block"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="submit" class="btn btn-success px-4">
            <i class="fas fa-save me-2"></i> Ekle
        </button>
        <a href="/AdminIcon/Liste" class="btn btn-outline-secondary px-4">
            <i class="fas fa-list me-2"></i> Listeye Dön
        </a>
    </div>
</form>

<br />
<div id="resultsucc" class="mt-3"></div>
<br />

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function buildIconHtml(classStr) {

        return '<i class="' + classStr + '"></i>';
    }

    function updatePreview(){
        const raw = $('#Icon').val().trim();
        const $host = $('#iconPreviewHost');
        if (!raw){ $host.hide().empty(); return; }

        const v5map = { fas:'fa-solid', far:'fa-regular', fab:'fa-brands', fal:'fa-light', fat:'fa-thin', fad:'fa-duotone' };

        const sizeRx = /^fa-(xs|sm|lg|xl|2xl|[2-9]x|10x)$/i;

        const tokens = raw
            .split(/\s+/)
            .map(t => v5map[t] ?? t)
            .filter(t => !sizeRx.test(t));

        const uniq = [...new Set(tokens)];
        const classStr = uniq.join(' ');

        $host.html(buildIconHtml(classStr)).show();
    }

    $(function(){
        $('#Icon').on('input', updatePreview);
        $('#Icon').on('paste', function(){ setTimeout(updatePreview, 50); });

        $('#statusToggle').on('click', function () {
            const wrapper = $(this).find('.toggle-wrapper');
            const label = $(this).find('.status-label span');
            const icon  = $(this).find('.status-label i');
            const isActive = wrapper.toggleClass('active').hasClass('active');

            label.text(isActive ? "Aktif" : "Pasif");
            icon.removeClass("bi-check-circle-fill text-success bi-x-circle-fill text-secondary")
                .addClass(isActive ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-secondary");

            $('.status-label').removeClass("text-success text-secondary")
                .addClass(isActive ? "text-success" : "text-secondary");

            $('#Status').val(isActive);
        });

        $('#iconAddForm').on('submit', function(e){
            e.preventDefault();
            const formData = $(this).serialize();
            $('#IconError, #StatusError, #resultsucc').html('');

            $.ajax({
                url:'/AdminIcon/Ekle', type:'POST', data:formData,
                success:function(response){
                    if (response.success){
                        sessionStorage.setItem("swalType","success");
                        sessionStorage.setItem("swalMessage","İkon başarıyla eklendi.");
                        window.location.href = response.redirectUrl;
                    } else if (response.errors){
                        if (response.errors.Icon)   $('#IconError').html(response.errors.Icon);
                        if (response.errors.Status) $('#StatusError').html(response.errors.Status);
                        if (response.errors._)      $('#resultsucc').html('<div class="alert alert-danger">'+response.errors._+'</div>');
                    } else {
                        $('#resultsucc').html('<div class="alert alert-danger">Kayıt başarısız oldu.</div>');
                    }
                },
                error:function(){ $('#resultsucc').html('<div class="alert alert-danger">Bir hata oluştu.</div>'); }
            });
        });
    });
</script>