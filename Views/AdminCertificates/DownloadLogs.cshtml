@model List<CertificateDownloadLogModel>

@{
    ViewData["Title"] = "İndirme Logları";
    Layout = "~/Views/Shared/_adminLayout.cshtml";
}

<style>
    .desc-cell {
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @@media (max-width: 768px) {
        .desc-cell {
            white-space: normal !important;
            overflow: visible !important;
            text-overflow: unset !important;
            display: -webkit-box !important;
            -webkit-line-clamp: unset !important;
            -webkit-box-orient: vertical !important;
            word-wrap: break-word !important;
        }
    }

    .table th, .table td {
        vertical-align: middle;
    }

    .text-muted small {
        word-break: break-all;
    }
</style>

<br />
<h4 class="card-title">Sertifika İndirme Logları</h4>
<hr />
<div class="row mb-2">
    <div class="col text-right">
        <select id="exportOptions" class="form-control form-control-sm w-100 mb-2 d-md-inline-block">
            <option value="">Dışa Aktar</option>
            <option value="excel">📥 Excel</option>
            <option value="pdf">📄 PDF</option>
            <option value="print">🖨️ Yazdır</option>
        </select>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-hover table-bordered align-middle" id="yourTableId">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Sertifika Adı</th>
                <th>IP Adresi</th>
                <th>Şehir</th>
                <th>Tarayıcı Bilgisi</th>
                <th>İndirilme Tarihi</th>
                <th class="text-center no-export">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int i = 1;
                foreach (CertificateDownloadLogModel item in Model)
                {
                    <tr id="row-@item.Id">
                        <td>@i</td>
                        <td class="desc-cell" title="@item.CertificateName">@item.CertificateName</td>
                        <td>@item.ClientIp</td>
                        <td>@item.City</td>
                        <td class="desc-cell" title="@item.UserAgent">
                            <small class="text-muted">@item.UserAgent</small>
                        </td>
                        <td class="upload-date" data-date="@item.DownloadUtc.ToString("O")"></td>
                        <td class="text-center">
                            <a href="javascript:void(0)" class="btn btn-outline-danger btn-sm" onclick="confirmDeleteLog('@item.Id')">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Henüz log kaydı bulunmuyor.</td>
                </tr>
            }
        </tbody>
    </table>

    <a class="btn btn-outline-secondary mt-3" href="/AdminSertifika/Liste">
        <i class="bi bi-arrow-left"></i> Sertifika Listesine Dön
    </a>
    <br />
    <br /><br />
</div>
@Html.AntiForgeryToken()
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    async function confirmDeleteLog(id) {
        const result = await Swal.fire({
            title: 'Emin misiniz?',
            text: "Bu log kaydı kalıcı olarak silinecek!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Evet, sil!',
            cancelButtonText: 'Vazgeç'
        });
        if (result.isConfirmed) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                const response = await fetch(`/AdminSertifika/IndirmeLogSil/${id}`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": token
                    }
                });
                const data = await response.json();
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Silindi!',
                        text: data.message,
                        timer: 1200,
                        showConfirmButton: false
                    });
                    const row = document.getElementById(`row-${id}`);
                    if (row) row.remove();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Hata!',
                        text: data.message
                    });
                }
            } catch (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Sunucu Hatası!',
                    text: 'Silme işlemi başarısız. Lütfen tekrar deneyin.'
                });
            }
        }
    }
</script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll(".upload-date").forEach(td => {
            const dateStr = td.getAttribute("data-date");
            if (dateStr) {
                const d = new Date(dateStr);
                const formatted = d.toLocaleDateString("tr-TR", {
                    day: "numeric",
                    month: "long",
                    year: "numeric",
                    weekday: "long",
                    hour: "2-digit",
                    minute: "2-digit"
                });
                td.textContent = formatted.charAt(0).toUpperCase() + formatted.slice(1);
            }
        });
    });
</script>