@model string

@{
    string host = Context.Request.Host.Host;
    string[] parts = host.Replace("www.", "").Split('.');
    string domainName = parts[0];
}
<style>
    .cv-fab {
        position: fixed;
        right: 20px;
        bottom: 90px;
        z-index: 1100;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 50px;
        background: linear-gradient(135deg, #0d6efd, #5aa3ff);
        color: #fff;
        font-weight: 600;
        letter-spacing: 0.3px;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.25);
        box-shadow: 0 8px 28px rgba(13, 110, 253, 0.35);
        backdrop-filter: saturate(140%) blur(3px);
        transition: all 0.25s ease;
        overflow: hidden;
    }

        .cv-fab i {
            font-size: 19px;
            line-height: 1;
            transition: transform 0.25s ease;
        }

        .cv-fab:hover {
            color: #fff;
            transform: translateY(-3px);
            box-shadow: 0 14px 34px rgba(13, 110, 253, 0.45);
            filter: brightness(1.05);
        }

            .cv-fab:hover i {
                transform: scale(1.15) rotate(-5deg);
            }

    .cv-label {
        font-size: 15px;
        font-weight: 700;
    }
    .cv-fab::before {
        content: "";
        position: absolute;
        inset: -6px;
        border-radius: inherit;
        box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.4);
        animation: pulseFab 2.5s ease-out infinite;
        z-index: -1;
    }

    @@keyframes pulseFab {
        0%

    {
        box-shadow: 0 0 0 0 rgba(13, 110, 253, 0.4);
    }

    70% {
        box-shadow: 0 0 0 16px rgba(13, 110, 253, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(13, 110, 253, 0);
    }

    }

    @@media (hover: hover) {
        .cv-fab[data-tip]::after

    {
        content: attr(data-tip);
        position: absolute;
        right: 100%;
        margin-right: 10px;
        bottom: 50%;
        transform: translateY(50%) scale(0.95);
        opacity: 0;
        pointer-events: none;
        background: #111827;
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        padding: 6px 10px;
        border-radius: 6px;
        white-space: nowrap;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .cv-fab:hover::after {
        opacity: 1;
        transform: translateY(50%) scale(1);
    }

    }
   @@media (max-width: 576px) {
        .cv-fab

    {
        right: 16px;
        bottom: 80px;
        padding: 12px 18px;
        border-radius: 999px;
        gap: 8px;
    }

    .cv-label {
        display: inline;
        font-size: 14px;
    }

    .cv-fab i {
        font-size: 18px;
    }

    }
    @@media (prefers-reduced-motion: reduce) {
        .cv-fab, .cv-fab::before, .cv-fab:hover

    {
        transition: none;
        animation: none;
    }

    }
</style>
@if (!string.IsNullOrEmpty(Model))
{
    <a href="/Home/DownloadCV"
       class="cv-fab"
       title="CV’yi indir / görüntüle"
       data-tip="CV’yi indir"
       aria-label="CV / Özgeçmiş (PDF)">
        <i class="fas fa-file-alt" aria-hidden="true"></i>
        <span class="cv-label">CV</span>
    </a>
}
else
{
    <p class="text-muted text-center mt-3">Henüz CV yüklenmemiş.</p>
}
